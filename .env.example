LENA_BOOTSTRAP_RUNTIME_FROM_SCRAPER=false

# Safe degraded mode for a clean machine
LENA_STT_PROVIDER=mock
LENA_REWRITE_PROVIDER=template
LENA_TTS_PROVIDER=mock
LENA_SESSION_TIMEOUT_SECONDS=300

# Optional local LLM mode
# LENA_REWRITE_PROVIDER=ollama
# LENA_OLLAMA_URL=http://127.0.0.1:11434
# Current tested default:
# LENA_OLLAMA_MODEL=translategemma:4b
# Experimental alternative to evaluate locally:
# LENA_OLLAMA_MODEL=qwen3:4b
# LENA_OLLAMA_TIMEOUT_SECONDS=45

# Optional local speech-to-text
# LENA_STT_PROVIDER=faster_whisper

# Optional local Piper text-to-speech
# LENA_TTS_PROVIDER=piper
# LENA_PIPER_BINARY=tools/piper/piper/piper.exe
# LENA_PIPER_VOICE_MODELS={"de":"data/voices/piper/de_DE-thorsten-high.onnx","en":"data/voices/piper/en_GB-alan-medium.onnx","pl":"data/voices/piper/pl_PL-darkman-medium.onnx","ro":"data/voices/piper/ro_RO-mihai-medium.onnx","ru":"data/voices/piper/ru_RU-ruslan-medium.onnx"}

# Retrieval / grounding thresholds
# LENA_MINIMUM_MATCH_THRESHOLD=0.08
# LENA_WEAK_MATCH_THRESHOLD=0.18
# LENA_CLARIFICATION_GAP_THRESHOLD=0.03
