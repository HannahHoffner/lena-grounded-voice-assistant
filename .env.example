# The application works without Blablador.
REWRITE_PROVIDER=template

# Optional Blablador/OpenAI-compatible answer formulation.
BLABLADOR_BASE_URL=https://api.blablador.fz-juelich.de/v1
BLABLADOR_API_KEY=
BLABLADOR_MODEL=

# Full-list fallback is skipped if the compact context exceeds this limit.
BLABLADOR_MAX_CONTEXT_CHARS=50000
# Separate wall-clock limits for the compact router and larger formulator.
LLM_ROUTER_TIMEOUT_SECONDS=15
LLM_FORMULATOR_TIMEOUT_SECONDS=30
# Legacy fallback when the separate values are omitted:
# BLABLADOR_TIMEOUT_SECONDS=30
BLABLADOR_MAX_TOKENS=2000

# Optional canonical data path and local session lifetime.
# LENA_KB_PATH=data/canonical/offers.json
SESSION_TIMEOUT_SECONDS=180
QUERY_MAX_CHARS=1000

# Technical events never contain full interactions. Full query/answer pairs are
# stored separately and locally for prototype evaluation; disable when needed.
TECHNICAL_LOG_LEVEL=INFO
INTERACTION_LOGGING_ENABLED=true
INTERACTION_LOG_PATH=runtime/logs/interactions.jsonl

# Optional OpenAI-compatible server-side speech transcription. When omitted,
# the Blablador URL/key are reused if present; the default model is shown here.
# SPEECH_TRANSCRIPTION_BASE_URL=https://speech.example/v1
# SPEECH_TRANSCRIPTION_API_KEY=replace-with-local-secret
SPEECH_TRANSCRIPTION_MODEL=whisper-large-v3
STT_TIMEOUT_SECONDS=45
SPEECH_TRANSCRIPTION_MAX_BYTES=10485760

# Speech synthesis uses edge-tts by default. Set provider=openai only with a
# compatible endpoint and credentials.
SPEECH_SYNTHESIS_PROVIDER=edge
# SPEECH_SYNTHESIS_BASE_URL=https://speech.example/v1
# SPEECH_SYNTHESIS_API_KEY=replace-with-local-secret
# SPEECH_SYNTHESIS_MODEL=gpt-4o-mini-tts
SPEECH_SYNTHESIS_VOICE=alloy
SPEECH_SYNTHESIS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT_SECONDS=45
SPEECH_SYNTHESIS_MAX_CHARS=4000

# WFS source synchronization. Checks never occur during a user query.
WFS_URL=https://geodienste.leipzig.de/l3/OpenData/wohnungslosenhilfe/wfs
WFS_AUTO_SYNC=true
WFS_AUTO_PROMOTE=false
WFS_CHECK_INTERVAL_HOURS=24
WFS_CONNECT_TIMEOUT_SECONDS=10
WFS_READ_TIMEOUT_SECONDS=30
