# LENA – Konfigurationsvorlage (keine Secrets eintragen und nie committen)
#
# Verwendung
#   Checkout:  als .env kopieren (oder .env.local für persönliche Overrides).
#   Docker:    Werte mit `docker run --env-file <datei>` oder `-e NAME` übergeben;
#              im Image werden .env/.env.local nicht gelesen (LENA_ENV_FILE_MODE=disabled).
# Priorität (niedrig -> hoch): eingebaute Defaults < .env < .env.local < Prozessumgebung.
#   CLI-Optionen wie `--rewrite-provider` setzen die Prozessumgebung und gewinnen.
# Diagnose: /api/health -> "external_services" und "configuration_warnings"
#   (Profilstatus, Modellkennungen und fehlende Variablennamen, keine Keys).
#   Aktive Prüfung: `python -m app.service_check [--synthesize]`.
#
# Die Vorlage wählt ein sicheres Startprofil: ohne Aktivierung eines Providers
# startet LENA mit lokalen Daten, ohne externe Server-Dienste, ohne Quellabrufe und ohne
# Interaktionsprotokoll. Nur die Kartenkacheln lädt der Browser von OpenStreetMap
# (MAP_PROVIDER=disabled schaltet das ab).

# ---------------------------------------------------------------------------
# 1. LLM (Interpreter, Selector, Formulator)
# ---------------------------------------------------------------------------
# template  = kein LLM. Die Anwendung startet, beantwortet aber KEINE fachliche
#             Freitextsuche: jede normale Anfrage endet im technischen Hinweis
#             mit Hilfebus-Kontaktkarte (Systemgrenze, kein Fehler).
# blablador = OpenAI-kompatibler Chat-Endpunkt für alle drei Stufen; Voraussetzung
#             für die reguläre Text- und Sprachsuche.
REWRITE_PROVIDER=template
BLABLADOR_BASE_URL=https://api.blablador.fz-juelich.de/v1
BLABLADOR_API_KEY=
# Modellalias des Anbieters (z. B. alias-fast); Aliase können sich ändern.
BLABLADOR_MODEL=
# Optionale Stufenmodelle; ohne Angabe gilt BLABLADOR_MODEL.
# BLABLADOR_INTERPRETER_MODEL=alias-fast
# BLABLADOR_SELECTOR_MODEL=alias-fast
# BLABLADOR_FORMULATOR_MODEL=alias-fast
# Ein Formulatoraufruf entfällt, wenn sein Evidence-Paket diese Größe überschreitet.
BLABLADOR_MAX_CONTEXT_CHARS=50000
# Vorlagenwert 2000; ohne diese Zuweisung gilt der Code-Default 1200.
BLABLADOR_MAX_TOKENS=2000
# Getrennte Stufengrenzen und kumuliertes Providerbudget pro Anfrage (Sekunden).
# Jede Stufe unterhalb des Budgets halten; das Budget kürzt ohnehin auf den Rest.
LLM_INTERPRETER_TIMEOUT_SECONDS=15
LLM_SELECTOR_TIMEOUT_SECONDS=10
LLM_FORMULATOR_TIMEOUT_SECONDS=30
LLM_REQUEST_BUDGET_SECONDS=45
#
# Dokumentiertes Messprofil (22.10. und gezielte Prüfung 26.10.2026), kein Default:
#   REWRITE_PROVIDER=blablador  BLABLADOR_MODEL=alias-fast  BLABLADOR_MAX_TOKENS=4096
#   LLM_INTERPRETER_TIMEOUT_SECONDS=15  LLM_SELECTOR_TIMEOUT_SECONDS=30
#   LLM_FORMULATOR_TIMEOUT_SECONDS=30   LLM_REQUEST_BUDGET_SECONDS=45

# ---------------------------------------------------------------------------
# 2. Serverseitige Spracherkennung (STT), optional
# ---------------------------------------------------------------------------
# disabled  = keine Server-STT; der Browser nutzt ggf. seine eigene Spracherkennung
#             (browserabhängig, kann selbst einen externen Dienst verwenden).
# blablador = ausdrücklich den LLM-Zugang oben wiederverwenden; Modell-Default
#             faster-whisper-large-v3 (im Blablador-Modellinventar vorhanden).
# openai    = eigener OpenAI-kompatibler /audio/transcriptions-Endpunkt (Werte unten).
# Ohne Angabe: "openai", sobald eigene STT-Werte gesetzt sind, sonst "disabled".
# Kein Profil übernimmt Zugangsdaten stillschweigend.
SPEECH_TRANSCRIPTION_PROVIDER=disabled
# SPEECH_TRANSCRIPTION_BASE_URL=https://speech.example/v1
# SPEECH_TRANSCRIPTION_API_KEY=
# SPEECH_TRANSCRIPTION_MODEL=faster-whisper-large-v3
STT_TIMEOUT_SECONDS=45
SPEECH_TRANSCRIPTION_MAX_BYTES=10485760

# ---------------------------------------------------------------------------
# 3. Sprachausgabe (TTS), optional
# ---------------------------------------------------------------------------
# disabled = kein Vorlesen (Default; Text bleibt vollständig nutzbar).
# edge     = Microsoft-Edge-Neural-Stimmen über das Paket edge-tts; externer Dienst,
#            kein API-Key, Antworttexte verlassen den Rechner. Gepinnter Client
#            7.3.1 (7.2.8 lieferte HTTP 403); externer Dienst kann sich ändern.
# openai   = eigener OpenAI-kompatibler /audio/speech-Endpunkt; Endpunkt, Key und
#            ein dort TATSÄCHLICH angebotenes TTS-Modell sind Pflicht.
#            Hinweis: Der Blablador-Endpunkt bot am 23.10.2026 kein TTS-Modell an
#            (gpt-4o-mini-tts -> HTTP 404). Vor Nutzung prüfen:
#            python -m app.service_check --synthesize
# Ohne Angabe: "openai", sobald eigene TTS-Werte gesetzt sind, sonst "disabled".
SPEECH_SYNTHESIS_PROVIDER=disabled
# SPEECH_SYNTHESIS_BASE_URL=https://speech.example/v1
# SPEECH_SYNTHESIS_API_KEY=
# SPEECH_SYNTHESIS_MODEL=
SPEECH_SYNTHESIS_VOICE=alloy
SPEECH_SYNTHESIS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT_SECONDS=45
SPEECH_SYNTHESIS_MAX_CHARS=4000

# ---------------------------------------------------------------------------
# 4. Karte
# ---------------------------------------------------------------------------
# osm      = der Browser lädt Basiskacheln direkt von tile.openstreetmap.org.
# disabled = keine Basiskarte; Marker und Entfernungen bleiben lokal berechnet
#            (für Offline-Betrieb oder datensparsame Demos).
MAP_PROVIDER=osm
# Referenzkoordinate für die Luftliniensortierung (beide Werte gemeinsam,
# Leipziger Rahmen 51.1–51.6 / 12.0–12.8; sonst Leipzig Hauptbahnhof).
# HBF_LATITUDE=51.34556
# HBF_LONGITUDE=12.38222

# ---------------------------------------------------------------------------
# 5. Laufzeit, Daten, Sessions und Protokolle
# ---------------------------------------------------------------------------
# Beschreibbare Ablage außerhalb des Pakets (Wheel/Docker). Im Checkout
# standardmäßig ./data und ./runtime. Sessions sind sensible lokale Daten;
# nicht in Cloud-synchronisierte Ordner legen, wenn das vermieden werden soll.
# LENA_DATA_DIR=/var/lib/lena/data
# LENA_RUNTIME_DIR=/var/lib/lena/runtime
# Optionale abweichende Quellen (Wartung); Default sind die paketierten Bootstrap-Daten.
# LENA_KB_PATH=data/canonical/offers.json
# LENA_CURATION_PATH=/var/lib/lena/data/curation/social_offers.json
# disabled ignoriert .env/.env.local (Docker-Default, isolierte Prüfungen).
# LENA_ENV_FILE_MODE=disabled
SESSION_TIMEOUT_SECONDS=180
SESSION_MAX_ENTRIES=500
QUERY_MAX_CHARS=1000
# reviewed_only | reviewed_or_machine | source_language_fallback
TRANSLATION_RUNTIME_POLICY=reviewed_or_machine
# Zusätzliche Diagnosefelder sind begrenzt. Rohpfade, Uvicorn-Querylogs und
# Grundnachrichten/Exceptions können trotzdem sensible Inhalte enthalten (N-03).
# Kein allgemeiner Ausschluss von Nutzertexten oder Secrets; Aufbewahrung prüfen.
TECHNICAL_LOG_LEVEL=INFO
# Vollständige Frage/Antwort-Paare für Prototyp-Evaluationen; personenbezogen
# möglich, daher standardmäßig aus. Safety-Eingaben werden immer redigiert.
INTERACTION_LOGGING_ENABLED=false
INTERACTION_LOG_PATH=runtime/logs/interactions.jsonl

# ---------------------------------------------------------------------------
# 6. Quellabgleich (nur Wartung; nie während einer Nutzeranfrage)
# ---------------------------------------------------------------------------
# Auto-Sync erzeugt nur geprüfte Pending-Releases und ruft externe Quellen ab.
WFS_URL=https://geodienste.leipzig.de/l3/OpenData/wohnungslosenhilfe/wfs
WFS_AUTO_SYNC=false
WFS_AUTO_PROMOTE=false
WFS_CHECK_INTERVAL_HOURS=24
WFS_CONNECT_TIMEOUT_SECONDS=10
WFS_READ_TIMEOUT_SECONDS=30
TOILET_SOURCE_URL=https://geodaten.leipzig.de/open_data/organisationseinheit/Amt_fuer_Geoinformation_und_Bodenordnung/Toilettenstandorte/Oeffentliche_Toiletten_Stadt_Leipzig.csv
TOILET_AUTO_SYNC=false
# Automatische Aktivierung wird im Prototyp abgewiesen.
TOILET_AUTO_PROMOTE=false
TOILET_SYNC_INTERVAL_SECONDS=86400
TOILET_CONNECT_TIMEOUT_SECONDS=10
TOILET_READ_TIMEOUT_SECONDS=30
DRINKING_FOUNTAIN_SOURCE_URL=https://www.google.com/maps/d/kml?mid=1X3y_V9KdgtfsEucc4T-tmNV_hYe8rdEP&forcekml=1
DRINKING_FOUNTAIN_SOURCE_PAGE_URL=https://www.l.de/wasserwerke/leipziger-wasser/trinkwasserbrunnen/
DRINKING_FOUNTAIN_BOUNDARY_URL=https://static.leipzig.de/fileadmin/mediendatenbank/leipzig-de/Stadt/02.1_Dez1_Allgemeine_Verwaltung/12_Statistik_und_Wahlen/Geodaten/StatistischeBezirke_Leipzig_UTM33N.json
DRINKING_FOUNTAIN_AUTO_SYNC=false
DRINKING_FOUNTAIN_AUTO_PROMOTE=false
DRINKING_FOUNTAIN_SYNC_INTERVAL_SECONDS=86400
DRINKING_FOUNTAIN_CONNECT_TIMEOUT_SECONDS=10
DRINKING_FOUNTAIN_READ_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# 7. Live-Evaluation (nur bewusst freigegebene Läufe gegen echte Provider)
# ---------------------------------------------------------------------------
LENA_ALLOW_LIVE_SMOKE=false
