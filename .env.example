LENA_BOOTSTRAP_RUNTIME_FROM_SCRAPER=false

# Safe degraded mode for a clean machine
LENA_STT_PROVIDER=mock
LENA_REWRITE_PROVIDER=template
LENA_TTS_PROVIDER=mock
LENA_SESSION_TIMEOUT_SECONDS=300
LENA_TIMEZONE=Europe/Berlin

# Optional clean LENA v2 runtime. V1 remains the default when running `python -m app`.
# Start v2 separately with `python -m app.v2 --port 8001`.
# Runtime v2 reads this reviewed one-source KB and does not scrape live pages.
# V2 automatically prefers Blablador + faster_whisper + Piper at startup.
# Use CLI flags such as `--rewrite-provider template --stt-provider mock --tts-provider mock`
# when you explicitly want the degraded test profile.
# LENA_V2_KB_PATH=data/v2/curated_kb/offers.json

# Optional local LLM mode
# LENA_REWRITE_PROVIDER=ollama
# LENA_OLLAMA_URL=http://127.0.0.1:11434
# Current tested default:
# LENA_OLLAMA_MODEL=translategemma:4b
# Experimental alternative to evaluate locally:
# LENA_OLLAMA_MODEL=qwen3:4b
# LENA_OLLAMA_TIMEOUT_SECONDS=45

# Optional Blablador / OpenAI-compatible LLM mode
# Blablador tokens are Helmholtz Codebase/GitLab Personal Access Tokens with read_user scope.
# Never commit a real token.
# LENA_REWRITE_PROVIDER=blablador
# LENA_LLM_BASE_URL=https://api.blablador.fz-juelich.de/v1/
# LENA_LLM_API_KEY=replace-with-your-token
# LENA_LLM_MODEL=alias-large
# LENA_LLM_TIMEOUT_SECONDS=60
# LENA_LLM_MAX_TOKENS=800
# LENA_LLM_TEMPERATURE=0
# LENA_LLM_FALLBACK_PROVIDER=template
# LENA_LLM_EVAL_MODE=false
#
# Generic OpenAI-compatible endpoint:
# LENA_REWRITE_PROVIDER=openai_compatible
# LENA_LLM_BASE_URL=https://your-compatible-endpoint.example/v1/
# LENA_LLM_API_KEY=replace-with-your-token
# LENA_LLM_MODEL=your-model-or-alias

# Optional local speech-to-text
# LENA_STT_PROVIDER=faster_whisper

# Optional local Piper text-to-speech
# LENA_TTS_PROVIDER=piper
# LENA_PIPER_BINARY=tools/piper/piper/piper.exe
# Language-specific Piper voice models. Each .onnx file needs the matching .onnx.json next to it.
# LENA_PIPER_VOICE_DE=data/voices/piper/<german-voice>.onnx
# LENA_PIPER_VOICE_EN=data/voices/piper/<english-voice>.onnx
# LENA_PIPER_VOICE_PL=data/voices/piper/<polish-voice>.onnx
# LENA_PIPER_VOICE_RO=data/voices/piper/<romanian-voice>.onnx
# LENA_PIPER_VOICE_RU=data/voices/piper/<russian-voice>.onnx
# Optional explicit config paths if they are not simply the model path plus ".json".
# LENA_PIPER_VOICE_CONFIG_DE=data/voices/piper/<german-voice>.onnx.json
# LENA_PIPER_VOICE_CONFIG_EN=data/voices/piper/<english-voice>.onnx.json
# LENA_PIPER_VOICE_CONFIG_PL=data/voices/piper/<polish-voice>.onnx.json
# LENA_PIPER_VOICE_CONFIG_RO=data/voices/piper/<romanian-voice>.onnx.json
# LENA_PIPER_VOICE_CONFIG_RU=data/voices/piper/<russian-voice>.onnx.json
# Optional fallback voice for languages without a configured voice.
# LENA_PIPER_DEFAULT_VOICE=data/voices/piper/<fallback-voice>.onnx
# LENA_PIPER_DEFAULT_VOICE_CONFIG=data/voices/piper/<fallback-voice>.onnx.json
# Alternative JSON mapping style:
# LENA_PIPER_VOICE_MODELS={"de":"data/voices/piper/<german-voice>.onnx","en":"data/voices/piper/<english-voice>.onnx","pl":"data/voices/piper/<polish-voice>.onnx","ro":"data/voices/piper/<romanian-voice>.onnx","ru":"data/voices/piper/<russian-voice>.onnx"}

# Retrieval / grounding thresholds
# LENA_MINIMUM_MATCH_THRESHOLD=0.08
# LENA_WEAK_MATCH_THRESHOLD=0.18
# LENA_CLARIFICATION_GAP_THRESHOLD=0.03

# KB maintenance and safe promotion
# Candidate scraper output is blocked from runtime promotion when entries still need review,
# are stale, have unresolved conflicts, or lack source traceability.
# LENA_MAINTENANCE_ENFORCE_PROMOTE_REVIEW=true
# LENA_MAINTENANCE_ALLOW_NEEDS_REVIEW_PROMOTE=false

# Optional Blablador/OpenAI-compatible maintenance QC. This is separate from user answers.
# LENA_BUILD_QC_ENABLED=false
# LENA_BUILD_QC_PROVIDER=openai-compatible
# LENA_BUILD_QC_BASE_URL=https://api.blablador.fz-juelich.de/v1
# LENA_BUILD_QC_API_KEY=replace-with-your-token
# LENA_BUILD_QC_MODEL=alias-large
