# The application works without Blablador.
REWRITE_PROVIDER=template

# Optional Blablador/OpenAI-compatible interpretation, selection, and formulation.
BLABLADOR_BASE_URL=https://api.blablador.fz-juelich.de/v1
BLABLADOR_API_KEY=
BLABLADOR_MODEL=

# A formulator call is skipped if its final Evidence package exceeds this limit.
BLABLADOR_MAX_CONTEXT_CHARS=50000
# Separate wall-clock limits for interpreter, controlled selector, and formulator.
LLM_INTERPRETER_TIMEOUT_SECONDS=15
LLM_SELECTOR_TIMEOUT_SECONDS=10
LLM_FORMULATOR_TIMEOUT_SECONDS=30
# Cumulative actual provider-wait budget across all three stages per request.
LLM_REQUEST_BUDGET_SECONDS=45
# Legacy fallback when the separate values are omitted:
# BLABLADOR_TIMEOUT_SECONDS=30
BLABLADOR_MAX_TOKENS=2000

# Optional external data/runtime roots for wheel installs and services.
# LENA_DATA_DIR=C:/path/to/lena-data
# LENA_RUNTIME_DIR=C:/path/to/lena-runtime
# Optional canonical data path, local session lifetime and maximum entry count.
# LENA_KB_PATH=data/canonical/offers.json
# Optionaler externer Kurationskatalog; standardmäßig wird die paketierte,
# hashgebundene Prototyp-Kuration verwendet.
# LENA_CURATION_PATH=C:/path/to/lena-data/curation/social_offers.json
SESSION_TIMEOUT_SECONDS=180
SESSION_MAX_ENTRIES=500
QUERY_MAX_CHARS=1000
# Uses valid machine translations when no documented human review exists.
# Alternatives: reviewed_only, source_language_fallback.
TRANSLATION_RUNTIME_POLICY=reviewed_or_machine

# Referenzkoordinate für die räumliche Sortierung (Luftlinie, siehe
# app/spatial.py). Beide Werte müssen zusammen im Leipziger Umgebungsrahmen
# liegen (51.1-51.6 / 12.0-12.8), sonst gilt der Standard Leipzig Hauptbahnhof.
# HBF_LATITUDE=51.34556
# HBF_LONGITUDE=12.38222

# Technical events never contain full interactions. Full query/answer pairs are
# stored separately and locally for prototype evaluation; disable when needed.
TECHNICAL_LOG_LEVEL=INFO
INTERACTION_LOGGING_ENABLED=true
INTERACTION_LOG_PATH=runtime/logs/interactions.jsonl

# Optional OpenAI-compatible server-side speech transcription. When omitted,
# the Blablador URL/key are reused if present; the default model is shown here.
# SPEECH_TRANSCRIPTION_BASE_URL=https://speech.example/v1
# SPEECH_TRANSCRIPTION_API_KEY=replace-with-local-secret
SPEECH_TRANSCRIPTION_MODEL=whisper-large-v3
STT_TIMEOUT_SECONDS=45
SPEECH_TRANSCRIPTION_MAX_BYTES=10485760

# Speech synthesis uses edge-tts by default. Set provider=openai only with a
# compatible endpoint and credentials.
SPEECH_SYNTHESIS_PROVIDER=edge
# SPEECH_SYNTHESIS_BASE_URL=https://speech.example/v1
# SPEECH_SYNTHESIS_API_KEY=replace-with-local-secret
# SPEECH_SYNTHESIS_MODEL=gpt-4o-mini-tts
SPEECH_SYNTHESIS_VOICE=alloy
SPEECH_SYNTHESIS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT_SECONDS=45
SPEECH_SYNTHESIS_MAX_CHARS=4000

# WFS source synchronization. Checks create immutable releases and never occur
# during a user query. Auto-promotion activates only that same verified release.
WFS_URL=https://geodienste.leipzig.de/l3/OpenData/wohnungslosenhilfe/wfs
WFS_AUTO_SYNC=true
WFS_AUTO_PROMOTE=false
WFS_CHECK_INTERVAL_HOURS=24
WFS_CONNECT_TIMEOUT_SECONDS=10
WFS_READ_TIMEOUT_SECONDS=30

# Öffentliche Toiletten: Abruf darf nur einen Pending-Release erzeugen.
TOILET_SOURCE_URL=https://geodaten.leipzig.de/open_data/organisationseinheit/Amt_fuer_Geoinformation_und_Bodenordnung/Toilettenstandorte/Oeffentliche_Toiletten_Stadt_Leipzig.csv
TOILET_AUTO_SYNC=false
TOILET_AUTO_PROMOTE=false
TOILET_SYNC_INTERVAL_SECONDS=86400
TOILET_CONNECT_TIMEOUT_SECONDS=10
TOILET_READ_TIMEOUT_SECONDS=30

# Fest installierte Trinkwasserbrunnen der Leipziger Wasserwerke. Der KML-Abruf
# und die administrative Leipzig-Prüfung erzeugen nur einen Pending-Release.
DRINKING_FOUNTAIN_SOURCE_URL=https://www.google.com/maps/d/kml?mid=1X3y_V9KdgtfsEucc4T-tmNV_hYe8rdEP&forcekml=1
DRINKING_FOUNTAIN_SOURCE_PAGE_URL=https://www.l.de/wasserwerke/leipziger-wasser/trinkwasserbrunnen/
DRINKING_FOUNTAIN_BOUNDARY_URL=https://static.leipzig.de/fileadmin/mediendatenbank/leipzig-de/Stadt/02.1_Dez1_Allgemeine_Verwaltung/12_Statistik_und_Wahlen/Geodaten/StatistischeBezirke_Leipzig_UTM33N.json
DRINKING_FOUNTAIN_AUTO_SYNC=false
DRINKING_FOUNTAIN_AUTO_PROMOTE=false
DRINKING_FOUNTAIN_SYNC_INTERVAL_SECONDS=86400
DRINKING_FOUNTAIN_CONNECT_TIMEOUT_SECONDS=10
DRINKING_FOUNTAIN_READ_TIMEOUT_SECONDS=30
