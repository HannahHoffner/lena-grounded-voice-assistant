include README.md
include .env.example
include pyproject.toml
include LICENSE CITATION.cff THIRD_PARTY_NOTICES.md
include Dockerfile .dockerignore
include app/static/vendor/leaflet/LICENSE
recursive-include app *.py *.html *.css *.js *.png *.json *.geojson *.csv *.kml
recursive-include docs *.md
recursive-include requirements *.txt
recursive-include requirements *.lock
recursive-include tests *.py *.md *.cjs
prune data
prune runtime
prune build
prune dist
exclude .env .env.local
global-exclude *.py[cod] __pycache__ .pytest_cache

prune docs/exec-plans
prune docs/reviews
exclude docs/architecture/codebase-review.md
