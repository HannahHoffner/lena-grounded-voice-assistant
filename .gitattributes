# Keep text exports portable, including git archive on Windows with autocrlf.
* text=auto eol=lf

# Preserve exact manifest-bound bytes, including legacy mixed line endings.
# When introducing these rules, record the validated source files themselves;
# previously normalized Git blobs cannot reconstruct mixed line endings.
/data/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
/app/resources/bootstrap/** -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Historical development records remain in Git, outside the software release ZIP.
docs/exec-plans export-ignore
docs/reviews export-ignore
docs/architecture/codebase-review.md export-ignore

# Preserve exact archived evaluation bytes and original SHA-256 bindings.
/evaluation/pruefe_evidenz.py -text whitespace=cr-at-eol
/evaluation/manual_final_20261029/** -text whitespace=-trailing-space,-space-before-tab,cr-at-eol
/evaluation/speech-integration-2026-10-27/** -text whitespace=-trailing-space,-space-before-tab,cr-at-eol
